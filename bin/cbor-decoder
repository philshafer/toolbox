#!/usr/bin/env python3
#
# you might need:
#   pip install cbor2
#

import sys
import argparse
import json
import re
from pathlib import Path
import cbor2

def clean_and_parse_hex(raw_text: str) -> bytes:
    """
    Cleans structural hex-dump strings by stripping metadata lines,
    leading prefix characters (+ and >), and filtering down to valid
    two-digit hexadecimal byte numbers.
    """
    cleaned_tokens = []
    lines = raw_text.splitlines()
    
    for line in lines:
        # 1. Ignore leading '+' and '>' characters
        line_content = line.lstrip("+>")
        
        # 2. Skip metadata/header lines (e.g., "[cbor] @ 0")
        if "[" in line_content and "]" in line_content:
            continue
            
        # 3. Split the line into space-separated string tokens
        tokens = line_content.split()
        
        for token in tokens:
            # Match exactly two-digit hexadecimal string boundaries
            if re.match(r"^[0-9a-fA-F]{2}$", token):
                cleaned_tokens.append(token)
                
    hex_string = "".join(cleaned_tokens)
    
    if not hex_string:
        print("Error: No valid two-digit hex tokens were found in the provided text.", file=sys.stderr)
        sys.exit(1)
        
    try:
        return bytes.fromhex(hex_string)
    except ValueError as e:
        print(f"Error: Failed to convert text tokens into raw binary bytes ({e}).", file=sys.stderr)
        sys.exit(1)

def decode_cbor_bytes(cbor_bytes: bytes) -> str:
    """Decodes raw binary bytes into a pretty-printed JSON string."""
    try:
        python_data = cbor2.loads(cbor_bytes)
        return json.dumps(python_data, indent=2, ensure_ascii=False)
    except cbor2.CBORDecodeError as e:
        print(f"Error: Failed to decode data as valid CBOR ({e}).", file=sys.stderr)
        sys.exit(1)

def main():
    parser = argparse.ArgumentParser(
        description="Decode straight binary CBOR data or formatted hexadecimal text into pretty-printed JSON.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  python cbor_decoder.py input.txt output.json --hex
  cat input.txt | python cbor_decoder.py --hex > output.json
  python cbor_decoder.py binary_file.cbor output.json
        """
    )

    # Named option arguments
    parser.add_argument('-i', '--input', help='Path to the input CBOR file.')
    parser.add_argument('-o', '--output', help='Path to save the decoded JSON file.')
    parser.add_argument(
        '--hex', 
        action='store_true', 
        help='Enforce textual hexadecimal parsing (ignores "+", ">", header metadata tags, and non-hex ascii items).'
    )

    # Positional options serving as fallbacks if named arguments are missing
    parser.add_argument('positional_input', nargs='?', help=argparse.SUPPRESS)
    parser.add_argument('positional_output', nargs='?', help=argparse.SUPPRESS)

    args = parser.parse_args()

    # Preference hierarchy fallback logic
    input_source = args.input or args.positional_input
    output_target = args.output or args.positional_output

    # --- Step 1: Read Input Data ---
    if input_source:
        input_path = Path(input_source)
        if not input_path.is_file():
            print(f"Error: Input file does not exist or is not a file: '{input_source}'", file=sys.stderr)
            sys.exit(1)
        try:
            raw_data = input_path.read_bytes()
        except Exception as e:
            print(f"Error: Unable to read input file '{input_source}': {e}", file=sys.stderr)
            sys.exit(1)
    else:
        if sys.stdin.isatty():
            print("Error: No input data provided. Pass a file path or pipe data via stdin.", file=sys.stderr)
            parser.print_help()
            sys.exit(1)
        try:
            raw_data = sys.stdin.buffer.read()
        except Exception as e:
            print(f"Error: Unable to read data from standard input: {e}", file=sys.stderr)
            sys.exit(1)

    # --- Step 2: Extract Binary Stream Based on Execution Type ---
    if args.hex:
        # Enforce textual hex-dump string stripping
        try:
            text_string = raw_data.decode('utf-8', errors='replace')
            cbor_bytes = clean_and_parse_hex(text_string)
        except Exception as e:
            print(f"Error: Could not convert binary buffer into text for hex parsing: {e}", file=sys.stderr)
            sys.exit(1)
    else:
        # Default behavior: Try parsing as hex text first if looks safe, otherwise treat as straight binary
        try:
            text_content = raw_data.decode('utf-8', errors='strict').strip()
            cleaned_hex = text_content.replace(" ", "").replace("\n", "").replace("+", "").replace("-", "")
            cbor_bytes = bytes.fromhex(cleaned_hex)
        except (UnicodeDecodeError, ValueError):
            cbor_bytes = raw_data

    # --- Step 3: Decode CBOR to JSON ---
    json_output = decode_cbor_bytes(cbor_bytes)

    # --- Step 4: Save or Output Results ---
    if output_target:
        output_path = Path(output_target)
        if not output_path.parent.exists():
            print(f"Error: The destination directory '{output_path.parent}' does not exist.", file=sys.stderr)
            sys.exit(1)
        try:
            output_path.write_text(json_output, encoding='utf-8')
        except Exception as e:
            print(f"Error: Unable to write JSON output to '{output_target}': {e}", file=sys.stderr)
            sys.exit(1)
    else:
        try:
            sys.stdout.write(json_output + "\n")
        except Exception as e:
            print(f"Error: Unable to write output to stdout: {e}", file=sys.stderr)
            sys.exit(1)

if __name__ == '__main__':
    main()

