#!/usr/bin/env python

import docutils.core 
import sys, getopt
import os
import getpass
import hashlib
import shlex
import time
  
def html(input, output):
    docutils.core.publish_file( 
        source_path = input,
        destination_path = output,
        writer_name ="html") 

MAX_AGE_DAYS = 14

def remove_old_files(top, days = MAX_AGE_DAYS):
   # Drop files that haven't been rewritten in `days` days, then any
   # directories left empty
   cutoff = time.time() - days * 24 * 60 * 60
   for dirpath, dirnames, filenames in os.walk(top, topdown = False):
      for name in filenames:
         path = os.path.join(dirpath, name)
         try:
            if os.lstat(path).st_mtime < cutoff:
               os.remove(path)
         except OSError:
            pass
      if dirpath != top:
         try:
            os.rmdir(dirpath)       # fails (fine) if not empty
         except OSError:
            pass

def main(argv):
   inputfile = ''
   outputfile = ''

   user = os.environ.get("USER") or getpass.getuser()
   DIR = f"/tmp/{user}-rst"
   remove_old_files(DIR)

   opts, args = getopt.getopt(argv,"hi:o:",["ifile=","ofile="])
   for opt, arg in opts:
      if opt == '-h':
         print ('rst2html -i <inputfile> -o <outputfile>')
         sys.exit()
      elif opt in ("-i", "--ifile"):
         inputfile = arg
      elif opt in ("-o", "--ofile"):
         outputfile = arg

#   print ('Input file is ', inputfile)
#   print ('Output file is ', outputfile)

   if len(inputfile) == 0:
      if len(args) > 0:
         inputfile = args.pop(0)
      else:
         inputfile = '/dev/stdin'

   if len(outputfile) == 0:
      if len(args) > 0:
         outputfile = args.pop(0)
      else:
         # Same input file, same output path, so an open window can
         # just be refreshed
         path = os.path.abspath(inputfile)
         hash = hashlib.md5(path.encode()).hexdigest()
         base = os.path.basename(inputfile)
         outdir = f"{DIR}/{hash}"
         os.makedirs(outdir, exist_ok = True)
         outputfile = f"{outdir}/{base}.html"

   html(inputfile, outputfile)

   os.system(f"open {shlex.quote(outputfile)}")

if __name__ == "__main__":
   main(sys.argv[1:])

