(version 1)
(deny default)

(allow sysctl-read)
;; system: stat anything not denied below
(allow file-read-metadata)

;; ---------- basic dir traversal -----------------------------------
;; system:3: +r =/ =/private
(allow file-read*
  (literal "/")
  (literal "/private")
)

;; ---------- hide everything in ~ unless allowed below -------------
;; system:6: -a ~
(deny file-read* file-write* process-exec file-ioctl file-map-executable
  (subpath "/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/optional/home")
)

;; ---------- system runtime ----------------------------------------
;; system:9: +rxm /System /usr /bin /sbin /Library/Frameworks /opt /private/etc /var/db/dyld
(allow file-read* process-exec file-map-executable
  (subpath "/System")
  (subpath "/usr")
  (subpath "/bin")
  (subpath "/sbin")
  (subpath "/Library/Frameworks")
  (subpath "/opt")
  (subpath "/private/etc")
  (subpath "/var/db/dyld")    ;; does not exist
  (subpath "/private/var/db/dyld")    ;; does not exist
)
;; system:10: +rxm /Applications/Xcode.app /Library/Developer /opt/local ~/.local
(allow file-read* process-exec file-map-executable
  (subpath "/Applications/Xcode.app")
  (subpath "/Library/Developer")
  (subpath "/opt/local")
  (subpath "/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/optional/home/.local")
)
;; system:10: parent directories (stat only)
(allow file-read-metadata
  (literal "/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/optional/home")
)

;; ---------- claude binary -----------------------------------------
;; system:13: +rxm /Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/optional/home/.local/bin/
(allow file-read* process-exec file-map-executable
  (subpath "/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/optional/home/.local/bin")
)

;; ---------- temp dirs ---------------------------------------------
;; system:16: +rw /tmp/ $TMPDIR/../
(allow file-read* file-write*
  (subpath "/tmp")
  (subpath "/private/tmp")
  (subpath "/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/optional/var")
)

;; ---------- Claude config & token files ---------------------------
;; system:19: +rw ~/.claude/ r"^$HOME/\.claude\.json(\..*)?$"
(allow file-read* file-write*
  (subpath "/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/optional/home/.claude")
  (regex "^/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/optional/home/\\.claude\\.json(\\..*)?$")
)

;; ---------- time-zone & prefs (RO) --------------------------------
;; system:22: +r /private/var/db/timezone/ /Library/Preferences/ ~/Library/Preferences/
(allow file-read*
  (subpath "/private/var/db/timezone")
  (subpath "/Library/Preferences")
  (subpath "/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/optional/home/Library/Preferences")
)
;; system:22: parent directories (stat only)
(allow file-read-metadata
  (literal "/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/optional/home/Library")
)

;; ---------- /dev access -------------------------------------------
;; system:25: +r =/dev
(allow file-read*
  (literal "/dev")
)
;; system:26: +rw r"^/dev/(tty.*|null|zero|dtracehelper)"
(allow file-read* file-write*
  (regex "^/dev/(tty.*|null|zero|dtracehelper)")
)
;; system:27: +i =/dev/dtracehelper r"^/dev/tty.*"
(allow file-read* file-ioctl
  (literal "/dev/dtracehelper")
  (regex "^/dev/tty.*")
)
;; system:28: +rwi /dev/fd/ =/dev/stdin =/dev/stdout =/dev/stderr
(allow file-read* file-write* file-ioctl
  (subpath "/dev/fd")
  (literal "/dev/stdin")
  (literal "/dev/fd/0")
  (literal "/dev/stdout")
  (literal "/dev/fd/1")
  (literal "/dev/stderr")
  (literal "/dev/fd/2")
)
;; cwd:1: +rwxm $CWD
(allow file-read* file-write* process-exec file-map-executable
  (subpath "/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/optional/proj")
)
;; optional: "?" drops a path whose ${NAME} is unset or empty
;; conf:2: +rwx ?${SB_DESTDIR}
(allow file-read* file-write* process-exec
  (subpath "/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/optional/dest")
)

;; one kept, two dropped (unset, empty), one plain
;; conf:5: +r ?${SB_PROJ}/build ?${SB_UNSET}/a ?${SB_EMPTY}/b .exrc
;;   skipped: ?${SB_UNSET}/a (SB_UNSET not set)
;;   skipped: ?${SB_EMPTY}/b (SB_EMPTY is empty)
(allow file-read*
  (subpath "/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/optional/home/proj/build")    ;; does not exist
  (subpath "/somewhere/build")    ;; does not exist
  (literal "/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/optional/home/.exrc")
)
;; conf:5: parent directories (stat only)
(allow file-read-metadata
  (literal "/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/optional/home/proj")
)

;; quoted, literal, and regex forms
;; conf:8: +r ?"${SB_UNSET}/with space" ?=${SB_UNSET}/lit ?r"^${SB_UNSET}/.*"
;;   skipped: ?"${SB_UNSET}/with space" (SB_UNSET not set)
;;   skipped: ?=${SB_UNSET}/lit (SB_UNSET not set)
;;   skipped: ?r"^${SB_UNSET}/.*" (SB_UNSET not set)
;; conf:9: +r ?"${SB_PROJ} dir" ?=${SB_PROJ}.lit ?r"^/${SB_PROJ}/.*"
(allow file-read*
  (subpath "/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/optional/home/proj dir")    ;; does not exist
  (literal "/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/optional/home/proj.lit")
  (regex "^/proj/.*")
)

;; a "?" path with no variables (or only built-in ones) is always kept
;; conf:12: +r ?.vimrc ?${CWD}/sub
(allow file-read*
  (literal "/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/optional/home/.vimrc")
  (subpath "/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/optional/proj/sub")
)

;; two variables in one path, one of them unset
;; conf:15: +r ?${SB_PROJ}/${SB_UNSET}
;;   skipped: ?${SB_PROJ}/${SB_UNSET} (SB_UNSET not set)

;; denies, too
