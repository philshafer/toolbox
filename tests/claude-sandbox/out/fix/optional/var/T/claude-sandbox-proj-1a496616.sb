;;   skipped: ?${SB_UNSET}/logs (SB_UNSET not set)

;; @rewrite with an optional side is dropped as a whole
;; conf:21: @rewrite ?${SB_UNSET}/ /nowhere/
;;   skipped: ?${SB_UNSET}/ (SB_UNSET not set)
;; conf:22: @rewrite ?${SB_PROJ}/ /somewhere/

;; ---------- forced denies (not overridable) ----------------------
