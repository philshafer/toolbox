;; ------------------------------------------------------------------
;;  Claude Code macOS sandbox profile (autogenerated)
;;  generated: 2026-10-17 12:29:33
;;  workspace: /Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/quoting/proj
;;  config:    /Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/quoting.conf
;; ------------------------------------------------------------------
(version 1)
(deny default)

(allow sysctl-read)
;; system: stat anything not denied below
(allow file-read-metadata)

;; ---------- basic dir traversal -----------------------------------
;; system:3: +r =/ =/private
(allow file-read*
  (literal "/")
  (literal "/private")
)

;; ---------- hide everything in ~ unless allowed below -------------
;; system:6: -a ~
(deny file-read* file-write* process-exec file-ioctl file-map-executable
  (subpath "/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/quoting/home")
)

;; ---------- system runtime ----------------------------------------
;; system:9: +rxm /System /usr /bin /sbin /Library/Frameworks /opt /private/etc /var/db/dyld
(allow file-read* process-exec file-map-executable
  (subpath "/System")
  (subpath "/usr")
  (subpath "/bin")
  (subpath "/sbin")
  (subpath "/Library/Frameworks")
  (subpath "/opt")
  (subpath "/private/etc")
  (subpath "/var/db/dyld")    ;; does not exist
  (subpath "/private/var/db/dyld")    ;; does not exist
)
;; system:10: +rxm /Applications/Xcode.app /Library/Developer /opt/local ~/.local
(allow file-read* process-exec file-map-executable
  (subpath "/Applications/Xcode.app")
  (subpath "/Library/Developer")
  (subpath "/opt/local")
  (subpath "/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/quoting/home/.local")
)
;; system:10: parent directories (stat only)
(allow file-read-metadata
  (literal "/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/quoting/home")
)

;; ---------- claude binary -----------------------------------------
;; system:13: +rxm /Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/quoting/home/.local/bin/
(allow file-read* process-exec file-map-executable
  (subpath "/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/quoting/home/.local/bin")
)

;; ---------- temp dirs ---------------------------------------------
;; system:16: +rw /tmp/ $TMPDIR/../
(allow file-read* file-write*
  (subpath "/tmp")
  (subpath "/private/tmp")
  (subpath "/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/quoting/var")
)

;; ---------- Claude config & token files ---------------------------
;; system:19: +rw ~/.claude/ r"^$HOME/\.claude\.json(\..*)?$"
(allow file-read* file-write*
  (subpath "/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/quoting/home/.claude")
  (regex "^/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/quoting/home/\\.claude\\.json(\\..*)?$")
)

;; ---------- time-zone & prefs (RO) --------------------------------
;; system:22: +r /private/var/db/timezone/ /Library/Preferences/ ~/Library/Preferences/
(allow file-read*
  (subpath "/private/var/db/timezone")
  (subpath "/Library/Preferences")
  (subpath "/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/quoting/home/Library/Preferences")
)
;; system:22: parent directories (stat only)
(allow file-read-metadata
  (literal "/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/quoting/home/Library")
)

;; ---------- /dev access -------------------------------------------
;; system:25: +r =/dev
(allow file-read*
  (literal "/dev")
)
;; system:26: +rw r"^/dev/(tty.*|null|zero|dtracehelper)"
(allow file-read* file-write*
  (regex "^/dev/(tty.*|null|zero|dtracehelper)")
)
;; system:27: +i =/dev/dtracehelper r"^/dev/tty.*"
(allow file-read* file-ioctl
  (literal "/dev/dtracehelper")
  (regex "^/dev/tty.*")
)
;; system:28: +rwi /dev/fd/ =/dev/stdin =/dev/stdout =/dev/stderr
(allow file-read* file-write* file-ioctl
  (subpath "/dev/fd")
  (literal "/dev/stdin")
  (literal "/dev/fd/0")
  (literal "/dev/stdout")
  (literal "/dev/fd/1")
  (literal "/dev/stderr")
  (literal "/dev/fd/2")
)
;; cwd:1: +rwxm $CWD
(allow file-read* file-write* process-exec file-map-executable
  (subpath "/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/quoting/proj")
)
;; quoting: spaces, quotes, backslashes, and comments
;; conf:2: +rw "My Docs" "/tmp/with space/"
(allow file-read* file-write*
  (subpath "/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/quoting/home/My Docs")
  (subpath "/tmp/with space")
  (subpath "/private/tmp/with space")
)
;; conf:3: +rw r"^/x\"y\.z" r"^$HOME/\.claude\.json(\..*)?$"
(allow file-read* file-write*
  (regex "^/x\\\"y\\.z")
  (regex "^/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/quoting/home/\\.claude\\.json(\\..*)?$")
)
;; conf:4: +r ="#hash" # a trailing comment
(allow file-read*
  (literal "/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/quoting/home/#hash")
)
;; conf:5: +r "back\\slash" "quote\"d"
(allow file-read*
  (subpath "/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/quoting/home/back\\slash")    ;; does not exist
  (subpath "/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/quoting/home/quote\"d")    ;; does not exist
)

;; ---------- forced denies (not overridable) ----------------------
;; forced:3: -w =/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/quoting.conf
(deny file-write*
  (literal "/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/quoting.conf")
)
;; forced:4: -a ~/.ssh ~/.gnupg
(deny file-read* file-write* process-exec file-ioctl file-map-executable
  (subpath "/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/quoting/home/.ssh")
  (subpath "/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/quoting/home/.gnupg")    ;; does not exist
)

;; ---------- mach-lookup services ---------------------------------
(allow mach-lookup
  (global-name "com.apple.system.opendirectoryd.libinfo")
  (global-name "com.apple.SystemConfiguration.DNSConfiguration")
  (global-name "com.apple.coreservices.launchservicesd")
  (global-name "com.apple.CoreServices.coreservicesd")
  (global-name "com.apple.system.notification_center")
  (global-name "com.apple.logd")
  (global-name "com.apple.diagnosticd")
  (global-name "com.apple.lsd.mapdb")
  (global-name "com.apple.lsd.modifydb")
  (global-name "com.apple.coreservices.quarantine-resolver")
)

;; ---------- Launch Services needed by /usr/bin/open --------------
(allow mach-lookup
  (regex "^com\\.apple\\.lsd(\\..*)?$")   ;; lsd + its mapdb / modifydb helpers
)

;; ---------- Notification Center shared-memory (RO) ---------------
(allow ipc-posix-shm-read-data
  (ipc-posix-name "apple.shm.notification_center")
)

;; ---------- networking --------------------------------------------
(allow network*)

(allow process-fork)
(allow lsopen)
