;; ------------------------------------------------------------------
(version 1)
(deny default)

(allow sysctl-read)
;; system: stat anything not denied below
(allow file-read-metadata)

;; ---------- basic dir traversal -----------------------------------
;; system:3: +r =/ =/private
(allow file-read*
  (literal "/")
  (literal "/private")
)

;; ---------- hide everything in ~ unless allowed below -------------
;; system:6: -a ~
(deny file-read* file-write* process-exec file-ioctl file-map-executable
  (subpath "/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/env/home")
)

;; ---------- system runtime ----------------------------------------
;; system:9: +rxm /System /usr /bin /sbin /Library/Frameworks /opt /private/etc /var/db/dyld
(allow file-read* process-exec file-map-executable
  (subpath "/System")
  (subpath "/usr")
  (subpath "/bin")
  (subpath "/sbin")
  (subpath "/Library/Frameworks")
  (subpath "/opt")
  (subpath "/private/etc")
  (subpath "/var/db/dyld")    ;; does not exist
  (subpath "/private/var/db/dyld")    ;; does not exist
)
;; system:10: +rxm /Applications/Xcode.app /Library/Developer /opt/local ~/.local
(allow file-read* process-exec file-map-executable
  (subpath "/Applications/Xcode.app")
  (subpath "/Library/Developer")
  (subpath "/opt/local")
  (subpath "/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/env/home/.local")
)
;; system:10: parent directories (stat only)
(allow file-read-metadata
  (literal "/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/env/home")
)

;; ---------- claude binary -----------------------------------------
;; system:13: +rxm /Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/env/home/.local/bin/
(allow file-read* process-exec file-map-executable
  (subpath "/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/env/home/.local/bin")
)

;; ---------- temp dirs ---------------------------------------------
;; system:16: +rw /tmp/ $TMPDIR/../
(allow file-read* file-write*
  (subpath "/tmp")
  (subpath "/private/tmp")
  (subpath "/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/env/var")
)

;; ---------- Claude config & token files ---------------------------
;; system:19: +rw ~/.claude/ r"^$HOME/\.claude\.json(\..*)?$"
(allow file-read* file-write*
  (subpath "/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/env/home/.claude")
  (regex "^/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/env/home/\\.claude\\.json(\\..*)?$")
)

;; ---------- time-zone & prefs (RO) --------------------------------
;; system:22: +r /private/var/db/timezone/ /Library/Preferences/ ~/Library/Preferences/
(allow file-read*
  (subpath "/private/var/db/timezone")
  (subpath "/Library/Preferences")
  (subpath "/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/env/home/Library/Preferences")
)
;; system:22: parent directories (stat only)
(allow file-read-metadata
  (literal "/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/env/home/Library")
)

;; ---------- /dev access -------------------------------------------
;; system:25: +r =/dev
(allow file-read*
  (literal "/dev")
)
;; system:26: +rw r"^/dev/(tty.*|null|zero|dtracehelper)"
(allow file-read* file-write*
  (regex "^/dev/(tty.*|null|zero|dtracehelper)")
)
;; system:27: +i =/dev/dtracehelper r"^/dev/tty.*"
(allow file-read* file-ioctl
  (literal "/dev/dtracehelper")
  (regex "^/dev/tty.*")
)
;; system:28: +rwi /dev/fd/ =/dev/stdin =/dev/stdout =/dev/stderr
(allow file-read* file-write* file-ioctl
  (subpath "/dev/fd")
  (literal "/dev/stdin")
  (literal "/dev/fd/0")
  (literal "/dev/stdout")
  (literal "/dev/fd/1")
  (literal "/dev/stderr")
  (literal "/dev/fd/2")
)
;; cwd:1: +rwxm $CWD
(allow file-read* file-write* process-exec file-map-executable
  (subpath "/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/env/proj")
)
;; env: ${NAME} expansion in paths, regexes, and @rewrite
;; conf:2: @rewrite ${SB_DESTDIR}/ /dest-alias/

;; conf:4: +rwx ${SB_DESTDIR}
(allow file-read* file-write* process-exec
  (subpath "/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/env/dest")
  (subpath "/dest-alias")
)
;; conf:5: +r work/${SB_PROJ}/build ${CWD}/sub ${HOME}/.vimrc
(allow file-read*
  (subpath "/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/env/home/work/foo/build")    ;; does not exist
  (subpath "/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/env/vol/work/foo/build")    ;; does not exist
  (subpath "/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/env/proj/sub")
  (literal "/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/env/home/.vimrc")
)
;; conf:5: parent directories (stat only)
(allow file-read-metadata
  (literal "/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/env/home/work")
  (literal "/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/env/home/work/foo")
)
;; conf:6: +rw r"^${SB_DESTDIR}/log.*"
(allow file-read* file-write*
  (regex "^/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/env/dest/log.*")
  (regex "^/dest-alias/log.*")
)

;; ---------- forced denies (not overridable) ----------------------
;; forced:3: -w =/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/env.conf
(deny file-write*
  (literal "/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/env.conf")
)
;; forced:4: -a ~/.ssh ~/.gnupg
(deny file-read* file-write* process-exec file-ioctl file-map-executable
  (subpath "/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/env/home/.ssh")
  (subpath "/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/env/home/.gnupg")    ;; does not exist
)

;; ---------- mach-lookup services ---------------------------------
(allow mach-lookup
  (global-name "com.apple.system.opendirectoryd.libinfo")
  (global-name "com.apple.SystemConfiguration.DNSConfiguration")
  (global-name "com.apple.coreservices.launchservicesd")
  (global-name "com.apple.CoreServices.coreservicesd")
  (global-name "com.apple.system.notification_center")
  (global-name "com.apple.logd")
  (global-name "com.apple.diagnosticd")
  (global-name "com.apple.lsd.mapdb")
  (global-name "com.apple.lsd.modifydb")
  (global-name "com.apple.coreservices.quarantine-resolver")
)

;; ---------- Launch Services needed by /usr/bin/open --------------
(allow mach-lookup
  (regex "^com\\.apple\\.lsd(\\..*)?$")   ;; lsd + its mapdb / modifydb helpers
)

;; ---------- Notification Center shared-memory (RO) ---------------
(allow ipc-posix-shm-read-data
  (ipc-posix-name "apple.shm.notification_center")
)

;; ---------- networking --------------------------------------------
(allow network*)

(allow process-fork)
(allow lsopen)
