;; ------------------------------------------------------------------
(version 1)
(deny default)

(allow sysctl-read)
;; system: stat anything not denied below
(allow file-read-metadata)

;; ---------- basic dir traversal -----------------------------------
;; system:3: +r =/ =/private
(allow file-read*
  (literal "/")
  (literal "/private")
)

;; ---------- hide everything in ~ unless allowed below -------------
;; system:6: -a ~
(deny file-read* file-write* process-exec file-ioctl file-map-executable
  (subpath "/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/basic/home")
)

;; ---------- system runtime ----------------------------------------
;; system:9: +rxm /System /usr /bin /sbin /Library/Frameworks /opt /private/etc /var/db/dyld
(allow file-read* process-exec file-map-executable
  (subpath "/System")
  (subpath "/usr")
  (subpath "/bin")
  (subpath "/sbin")
  (subpath "/Library/Frameworks")
  (subpath "/opt")
  (subpath "/private/etc")
  (subpath "/var/db/dyld")    ;; does not exist
  (subpath "/private/var/db/dyld")    ;; does not exist
)
;; system:10: +rxm /Applications/Xcode.app /Library/Developer /opt/local ~/.local
(allow file-read* process-exec file-map-executable
  (subpath "/Applications/Xcode.app")
  (subpath "/Library/Developer")
  (subpath "/opt/local")
  (subpath "/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/basic/home/.local")
)
;; system:10: parent directories (stat only)
(allow file-read-metadata
  (literal "/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/basic/home")
)

;; ---------- claude binary -----------------------------------------
;; system:13: +rxm /Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/basic/home/.local/bin/
(allow file-read* process-exec file-map-executable
  (subpath "/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/basic/home/.local/bin")
)

;; ---------- temp dirs ---------------------------------------------
;; system:16: +rw /tmp/ $TMPDIR/../
(allow file-read* file-write*
  (subpath "/tmp")
  (subpath "/private/tmp")
  (subpath "/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/basic/var")
)

;; ---------- Claude config & token files ---------------------------
;; system:19: +rw ~/.claude/ r"^$HOME/\.claude\.json(\..*)?$"
(allow file-read* file-write*
  (subpath "/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/basic/home/.claude")
  (regex "^/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/basic/home/\\.claude\\.json(\\..*)?$")
)

;; ---------- time-zone & prefs (RO) --------------------------------
;; system:22: +r /private/var/db/timezone/ /Library/Preferences/ ~/Library/Preferences/
(allow file-read*
  (subpath "/private/var/db/timezone")
  (subpath "/Library/Preferences")
  (subpath "/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/basic/home/Library/Preferences")
)
;; system:22: parent directories (stat only)
(allow file-read-metadata
  (literal "/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/basic/home/Library")
)

;; ---------- /dev access -------------------------------------------
;; system:25: +r =/dev
(allow file-read*
  (literal "/dev")
)
;; system:26: +rw r"^/dev/(tty.*|null|zero|dtracehelper)"
(allow file-read* file-write*
  (regex "^/dev/(tty.*|null|zero|dtracehelper)")
)
;; system:27: +i =/dev/dtracehelper r"^/dev/tty.*"
(allow file-read* file-ioctl
  (literal "/dev/dtracehelper")
  (regex "^/dev/tty.*")
)
;; system:28: +rwi /dev/fd/ =/dev/stdin =/dev/stdout =/dev/stderr
(allow file-read* file-write* file-ioctl
  (subpath "/dev/fd")
  (literal "/dev/stdin")
  (literal "/dev/fd/0")
  (literal "/dev/stdout")
  (literal "/dev/fd/1")
  (literal "/dev/stderr")
  (literal "/dev/fd/2")
)
;; cwd:1: +rwxm $CWD
(allow file-read* file-write* process-exec file-map-executable
  (subpath "/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/basic/proj")
)
;; basic: bare paths, explicit letters, directories vs files
;; conf:2: .exrc .vimrc
(allow file-read*
  (literal "/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/basic/home/.exrc")
  (literal "/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/basic/home/.vimrc")
