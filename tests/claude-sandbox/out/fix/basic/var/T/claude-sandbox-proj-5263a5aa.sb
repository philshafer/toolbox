  (literal "/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/basic/home/work")
)

;; a path that does not exist yet
;; conf:9: +rw not-yet
(allow file-read* file-write*
  (subpath "/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/basic/home/not-yet")    ;; does not exist
)

;; forced subpath and forced literal
;; conf:12: +r .exrc/ =Documents
(allow file-read*
  (subpath "/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/basic/home/.exrc")
  (literal "/Volumes/case/work/philshafer/toolbox/tests/claude-sandbox/out/fix/basic/home/Documents")
)

;; "a" means everything
;; conf:15: +a .local/share
(allow file-read* file-write* process-exec file-ioctl file-map-executable
